# ===================================================
# EcomVanta - Environment Variables (.env.local)
# ===================================================

# 1. Admin Panel Security Passcode (Optional)
# Default fallbacks if omitted: ecomvanta2026, arvian2026
ADMIN_PASSWORD=ecomvanta2026

# 2. Supabase Cloud Database (Optional)
# If you want to store contact leads & inquiries in Supabase Cloud, add your keys below.
# If omitted, all leads automatically save locally in data/leads.json!
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
